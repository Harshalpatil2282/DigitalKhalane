# ============================
# DigitalKhalane Production Environment
# Copy to Vercel Dashboard → Settings → Environment Variables
# ============================

# MongoDB (Use MongoDB Atlas for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/digitalkhalane?retryWrites=true&w=majority

# JWT (Generate strong random string: openssl rand -base64 32)
JWT_SECRET=your-super-secure-random-jwt-secret-here

# JWT Expires In
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=production

# Frontend URL (Your Vercel deployment URL)
CLIENT_URL=https://your-project.vercel.app

# ============================
# Cloudinary (Required for file uploads)
# Get from https://cloudinary.com/console
# ============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# ============================
# Optional: Analytics / Monitoring
# ============================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX